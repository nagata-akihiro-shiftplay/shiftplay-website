---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import HeroVisual from '../components/HeroVisual.astro';
import HomeTeaser from '../components/HomeTeaser.astro';
import Divider from '../components/Divider.astro';

const heroCta =
  'ease-[ease] gap-2 rounded-button py-3.5 text-[15px] transition-transform duration-100 active:scale-[0.97]';
---

<BaseLayout
  title="株式会社ShiftPlay｜生成AI研修・導入支援コンサルティング"
  description="生成AIを活用した研修・導入支援を通じて、企業の生産性向上に伴走するShiftPlayのコーポレートサイトです。"
>
  <section
    class="container-full section-px flex flex-wrap items-stretch gap-[clamp(32px,5vw,56px)] pt-[clamp(32px,6vw,60px)] pb-[clamp(40px,6vw,68px)]"
  >
    <div
      class="order-1 flex min-w-[300px] flex-1 basis-[480px] flex-col justify-center gap-[22px] max-[700px]:order-2"
    >
      <h1
        class="m-0 text-[clamp(32px,4.8vw,54px)] leading-[1.28] font-extrabold tracking-[-0.01em]"
      >
        働き方をシフトして<br />やりたいことに<br />時間を使おう!
      </h1>
      <p class="m-0 text-[clamp(17px,2vw,21px)] font-bold tracking-[0.02em]">
        〜Shift Your Work, Play Your Life.〜
      </p>
      <p class="text-muted m-0 text-base leading-[1.9]">
        生成AIを活用した研修・導入支援を通じて、<br />企業の生産性向上に伴走します。
      </p>
      <div class="mt-1.5 flex flex-wrap gap-3.5">
        <Button href="/download" variant="outline" class={`${heroCta} px-6`}>
          <Icon slot="icon" name="download" size={16} />資料ダウンロード
        </Button>
        <Button href="/contact" variant="solid" class={`${heroCta} px-[26px]`}>
          <Icon slot="icon" name="mail" size={16} />お問い合わせ
        </Button>
      </div>
    </div>
    <div
      class="order-2 min-h-[320px] min-w-[280px] flex-1 basis-[420px] max-[700px]:order-1 max-[700px]:min-h-[130px]"
    >
      <HeroVisual />
    </div>
  </section>

  <Divider containerClass="container-full" />

  <HomeTeaser
    eyebrow="SERVICE"
    subLabel="事業内容"
    heading="生成AIを、企業の力に。"
    body="生成AI研修の提供から、自社業務への導入支援、<br />活用定着まで一貫して伴走します。"
    ctaLabel="事業内容を見る"
    ctaHref="/service"
    imageSrc="/images/teasers/service.jpg"
    imageAlt="生成AIを活用した研修・コンサルティング・業務自動化などのソリューションイメージ"
    imageWidth={1200}
    imageHeight={800}
    imageLoading="eager"
    imageFetchpriority="high"
  />

  <Divider containerClass="container-full" />

  <HomeTeaser
    eyebrow="ABOUT"
    subLabel="会社情報"
    heading="人はもっと創造的になれる。"
    body="AIは、仕事を奪うものではありません。<br />人がより創造的な仕事に集中するためのパートナーです。<br /><br />ShiftPlayは、企業ごとの業務や課題に合わせた生成AI活用をご提案し、研修から導入、定着まで伴走します。<br />AIを導入することではなく、働き方を変えることが私たちの使命です。"
    ctaLabel="会社情報を見る"
    ctaHref="/company"
    imageSrc="/images/people/ceo.jpg"
    imageAlt="代表取締役 永田晃大"
    imageWidth={675}
    imageHeight={900}
  />
</BaseLayout>
