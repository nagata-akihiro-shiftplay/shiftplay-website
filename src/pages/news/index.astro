---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsRow from '../../components/NewsRow.astro';
import { newsItems } from '../../data/news';
---

<BaseLayout
  title="お知らせ｜株式会社ShiftPlay"
  description="株式会社ShiftPlayからのお知らせ一覧です。"
>
  <section class="container-news section-px pt-[clamp(28px,5vw,56px)] pb-[clamp(16px,3vw,24px)]">
    <div class="text-faint mb-[18px] flex items-center gap-2 text-[13px]">
      <a href="/" class="text-faint hover:text-accent no-underline">Home</a>
      <span>/</span>
      <span class="text-ink">お知らせ</span>
    </div>
    <h1 class="m-0 text-[clamp(28px,4vw,40px)] leading-[1.3] font-extrabold">お知らせ</h1>
  </section>

  <section class="container-news section-px pt-2 pb-[clamp(56px,7vw,80px)]">
    {newsItems.map((item) => <NewsRow {...item} />)}
  </section>
</BaseLayout>
