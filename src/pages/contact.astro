---
import BaseLayout from '../layouts/BaseLayout.astro';
import GhostHeading from '../components/GhostHeading.astro';
import FormField from '../components/form/FormField.astro';
import Input from '../components/form/Input.astro';
import Textarea from '../components/form/Textarea.astro';
import RadioGroup from '../components/form/RadioGroup.astro';
import PrivacyAgreementCheckbox from '../components/form/PrivacyAgreementCheckbox.astro';
import SubmitButton from '../components/form/SubmitButton.astro';
import FormErrorBanner from '../components/form/FormErrorBanner.astro';
import FormSuccessPanel from '../components/form/FormSuccessPanel.astro';

const inquiryOptions = [
  '生成AI法人研修について',
  '生成AI伴走型コンサルティングについて',
  '生成AI顧問サービスについて',
  '代表 永田への登壇依頼',
  '業務提携・営業について',
  'その他',
];
---

<BaseLayout
  title="お問い合わせ｜株式会社ShiftPlay"
  description="株式会社ShiftPlayへのお仕事のご依頼やご質問はこちらからお気軽にお問い合わせください。"
>
  <section class="container-form section-px pt-[clamp(36px,6vw,64px)] pb-[clamp(56px,7vw,88px)]">
    <GhostHeading
      watermark="CONTACT"
      label="お問い合わせ"
      watermarkClass="text-[clamp(44px,9vw,92px)]"
      labelRowClass="mb-7"
    />

    <div data-form-root>
      <div data-form-content>
        <h1 class="m-0 mb-5 text-[19px] leading-[1.7] font-extrabold">
          お仕事のご依頼やご質問などお気軽にお問い合わせください。
        </h1>
        <p class="text-muted m-0 mb-9 text-sm leading-[1.9]">
          内容を確認後、担当者よりご連絡させていただきます。<br
          />また、お客様のご利用環境、もしくは迷惑メール対策等の設定により届かない場合がございます。<br
          />返信がない場合は、迷惑メールフォルダ、設定などご確認の上、お手数ですが再度ご連絡いただけますと幸いです。
        </p>

        <form
          data-formspree-form
          action="https://formspree.io/f/xvzdrbjk"
          method="POST"
          class="flex flex-col gap-[26px]"
        >
          <input type="hidden" name="_subject" value="【ShiftPlay】お問い合わせフォーム" />
          <FormErrorBanner />

          <FormField label="会社名" for="company">
            <Input name="company" placeholder="例）株式会社ShiftPlay" autocomplete="organization" />
          </FormField>

          <FormField label="お名前" for="name" required>
            <Input name="name" placeholder="山田 太郎" autocomplete="name" required />
          </FormField>

          <FormField label="メールアドレス" for="email" required>
            <Input
              type="email"
              name="email"
              placeholder="example@mail.com"
              autocomplete="email"
              required
            />
          </FormField>

          <FormField label="電話番号" for="phone" required>
            <Input type="tel" name="phone" placeholder="09012341234" autocomplete="tel" required />
          </FormField>

          <FormField label="お問い合わせの種類" required labelRowClass="mb-3.5" fieldset>
            <RadioGroup name="inquiryType" options={inquiryOptions} required />
          </FormField>

          <FormField label="お問い合わせ内容" for="message" required>
            <Textarea name="message" placeholder="お問い合わせ内容をご入力ください" required />
          </FormField>

          <PrivacyAgreementCheckbox />

          <SubmitButton />
        </form>
      </div>

      <div data-form-success hidden>
        <FormSuccessPanel
          message="お問い合わせありがとうございます。担当者より折り返しご連絡いたします。"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initFormspreeForm } from '../scripts/formspreeForm';
  initFormspreeForm();
</script>
