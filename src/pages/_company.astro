---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import GhostHeading from '../components/GhostHeading.astro';
import AnchorNav from '../components/AnchorNav.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProfileRow from '../components/ProfileRow.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import Divider from '../components/Divider.astro';

const quickNav = [
  { num: '01', label: 'ミッション', href: '#mission' },
  { num: '02', label: '代表挨拶', href: '#message' },
  { num: '03', label: '会社情報', href: '#profile' },
];

const message = [
  'ShiftPlayという社名には、働き方をシフトすることで、人が本当に価値を生み出す仕事に集中できる環境をつくりたいという想いを込めています。',
  '生成AIは、単なる業務効率化のツールではありません。',
  '繰り返し作業をAIに任せ、人は考え、創り、挑戦する時間を増やす。',
  'その働き方の変化こそが、企業の競争力につながると私たちは考えています。',
  'ShiftPlayは、生成AI研修・導入支援・業務改善を通じて、企業の働き方をアップデートします。',
];

const profile = [
  { label: '会社名', value: '株式会社ShiftPlay' },
  { label: '設立', value: '2026年4月' },
  { label: '所在地', value: '東京都渋谷区道玄坂1丁目10番8号 渋谷道玄坂東急ビル2F-C' },
  { label: '代表者', value: '永田 晃大' },
  { label: '事業内容', value: '生成AI研修・導入支援事業' },
];

const sectionTitleSize = {
  eyebrowClass: 'text-[clamp(24px,3.6vw,32px)]',
  subLabelClass: 'mb-7',
};
---

<BaseLayout
  title="会社情報｜株式会社ShiftPlay"
  description="株式会社ShiftPlayのミッション・代表挨拶・会社情報をご紹介します。"
  activeNav="company"
>
  <section class="container-article section-px pt-[clamp(36px,6vw,64px)] pb-[clamp(24px,4vw,40px)]">
    <GhostHeading watermark="ABOUT" label="会社情報" labelRowClass="mb-7" />
    <AnchorNav items={quickNav} />
  </section>

  <section id="mission" class="container-article section-px py-[clamp(28px,5vw,48px)]">
    <SectionTitle eyebrow="MISSION" subLabel="01 — ミッション" {...sectionTitleSize} />
    <h1 class="m-0 text-[clamp(26px,4vw,40px)] leading-[1.5] font-extrabold">
      働き方をシフトして、<br />やりたいことに時間を使おう。
    </h1>
  </section>

  <Divider />

  <RevealOnScroll
    as="section"
    id="message"
    class="container-article section-px py-[clamp(28px,5vw,48px)]"
  >
    <SectionTitle eyebrow="MESSAGE" subLabel="02 — 代表挨拶" {...sectionTitleSize} />
    <div class="flex flex-col gap-10 min-[701px]:flex-row min-[701px]:items-stretch">
      <div class="order-1 max-[700px]:order-2 min-[701px]:flex-[56_1_0%]">
        <h3 class="m-0 mb-6 text-[clamp(22px,3vw,28px)] leading-[1.5] font-extrabold">
          企業が本来の価値を<br />生み出せる働き方へ。
        </h3>
        <div class="flex flex-col gap-5">
          {message.map((para) => <p class="text-muted m-0 text-sm leading-[1.9]">{para}</p>)}
        </div>
      </div>
      <div class="order-2 flex flex-col max-[700px]:order-1 min-[701px]:flex-[44_1_0%]">
        <Image
          src="/images/people/ceo.jpg"
          alt="代表取締役 永田晃大"
          width={600}
          height={600}
          loading="lazy"
          class="rounded-block h-[320px] w-full object-cover min-[701px]:h-auto min-[701px]:min-h-[360px] min-[701px]:flex-1"
        />
        <div class="mt-3.5 text-right">
          <div class="text-faint text-xs">代表取締役</div>
          <div class="text-[17px] font-extrabold">永田 晃大</div>
          <div class="text-faint text-xs">Akihiro Nagata</div>
        </div>
      </div>
    </div>
  </RevealOnScroll>

  <Divider />

  <RevealOnScroll
    as="section"
    id="profile"
    class="container-article section-px py-[clamp(28px,5vw,48px)]"
  >
    <SectionTitle eyebrow="COMPANY" subLabel="03 — 会社情報" {...sectionTitleSize} />
    <div class="border-border rounded-block border bg-white p-[clamp(24px,4vw,36px)]">
      {profile.map((row) => <ProfileRow label={row.label} value={row.value} />)}
    </div>
  </RevealOnScroll>
</BaseLayout>
