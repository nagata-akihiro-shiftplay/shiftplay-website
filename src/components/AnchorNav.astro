---
// Pill-shaped quick-nav row (README: Training "01 解決できる課題" etc., Company "01 ミッション"
// etc. — identical markup/styling on both pages, only the item list differs).
interface NavItem {
  num: string;
  label: string;
  href: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<nav class="flex flex-wrap gap-2.5">
  {
    items.map((item) => (
      <a
        href={item.href}
        class="border-border text-muted hover:border-accent hover:text-accent rounded-full border px-4 py-[9px] text-[13px] font-semibold whitespace-nowrap no-underline"
      >
        {item.num} {item.label}
      </a>
    ))
  }
</nav>
