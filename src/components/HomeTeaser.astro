---
// Shared layout for the Home page's "Service" and "About" teaser sections
// (README: identical label/heading/body/CTA/image pattern, only copy differs).
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import RevealOnScroll from './RevealOnScroll.astro';

interface Props {
  eyebrow: string;
  subLabel: string;
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  imageSrc: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  imageLoading?: 'eager' | 'lazy';
  imageFetchpriority?: 'high' | 'low' | 'auto';
}

const {
  eyebrow,
  subLabel,
  heading,
  body,
  ctaLabel,
  ctaHref,
  imageSrc,
  imageAlt,
  imageWidth,
  imageHeight,
  imageLoading = 'lazy',
  imageFetchpriority = 'auto',
} = Astro.props;
---

<RevealOnScroll
  as="section"
  class="container-full section-px flex flex-wrap items-stretch gap-[clamp(28px,5vw,56px)] py-[clamp(28px,5vw,56px)]"
>
  <div
    class="order-1 flex min-w-[300px] flex-1 basis-[440px] flex-col justify-center gap-4 max-[700px]:order-2"
  >
    {
      /* README spec value was #9a9ca2 (~2.5:1 on the page background, a WCAG AA
      fail even at this large/bold size). Darkened to ~3.1:1 (Lighthouse a11y
      audit, 2026-07-22) — same visual weight, just legible. */
    }
    <p class="m-0 text-2xl font-bold tracking-[0.1em] text-[#8a8c91]">{eyebrow}</p>
    <p class="text-muted m-0 text-[15px] font-semibold">{subLabel}</p>
    <h2 class="m-0 text-[clamp(26px,3.4vw,38px)] leading-[1.3] font-extrabold">{heading}</h2>
    <p class="text-muted m-0 text-[15px] leading-[1.9]" set:html={body} />
    <Button
      href={ctaHref}
      variant="outline"
      class="rounded-button mt-1.5 w-fit gap-1.5 self-start px-[22px] py-3.5 text-[15px] transition-transform duration-100 ease-[ease] active:scale-[0.97]"
    >
      {ctaLabel}
      <Icon name="chevron-right" />
    </Button>
  </div>
  <div
    class="order-2 min-h-[280px] min-w-[280px] flex-1 basis-[420px] max-[700px]:order-1 max-[700px]:min-h-[110px]"
  >
    <Image
      src={imageSrc}
      alt={imageAlt}
      width={imageWidth}
      height={imageHeight}
      loading={imageLoading}
      fetchpriority={imageFetchpriority}
      class="rounded-panel h-full w-full object-cover"
    />
  </div>
</RevealOnScroll>
