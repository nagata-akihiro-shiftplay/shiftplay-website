---
// Blue h2 heading + gray "NN — label" sub-line, repeated per subsection (README: Training's
// PROBLEM/SERVICE MENU/FEATURES/FLOW/FAQ, Company's MISSION/MESSAGE/COMPANY). Font-size and
// sub-label margin differ slightly between the two pages (Training: clamp(22px,3.2vw,28px)
// heading / 20px margin; Company: clamp(24px,3.6vw,32px) / 28px margin) — override via
// `eyebrowClass`/`subLabelClass` rather than a preset enum.
interface Props {
  eyebrow: string;
  subLabel: string;
  eyebrowClass?: string;
  subLabelClass?: string;
}

const {
  eyebrow,
  subLabel,
  eyebrowClass = 'text-[clamp(22px,3.2vw,28px)]',
  subLabelClass = 'mb-5',
} = Astro.props;
---

<h2 class:list={['text-accent m-0 mb-2 font-extrabold tracking-[-0.01em]', eyebrowClass]}>
  {eyebrow}
</h2>
<p class:list={['text-muted m-0 text-[13px] font-semibold', subLabelClass]}>{subLabel}</p>
