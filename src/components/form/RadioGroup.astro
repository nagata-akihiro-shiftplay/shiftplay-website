---
interface Props {
  name: string;
  options: string[];
  required?: boolean;
}

const { name, options, required = false } = Astro.props;
---

<div class="flex flex-col gap-3">
  {
    options.map((opt) => (
      <label class="text-ink flex cursor-pointer items-center gap-2.5 py-2 text-sm">
        <input
          type="radio"
          name={name}
          value={opt}
          required={required ? 'required' : undefined}
          class="accent-accent h-4 w-4"
        />
        {opt}
      </label>
    ))
  }
</div>
