---
// Label/value row for a definition-list-style info table (README: Company's "03 会社情報").
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<div class="border-border-soft flex flex-wrap gap-x-6 gap-y-2 border-b py-[18px]">
  <div class="text-muted w-[140px] flex-none text-sm font-bold">{label}</div>
  <div class="text-ink min-w-[200px] flex-1 text-[15px] leading-[1.8]">{value}</div>
</div>
