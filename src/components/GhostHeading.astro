---
// Watermark English heading + dash + Japanese label pattern, repeated on every interior
// page (README: Service/Training/Company/Download/Contact/Privacy). The watermark's
// clamp() range differs slightly per page (e.g. Service/Company: clamp(44px,9vw,84px),
// Training: clamp(40px,8vw,76px), Download/Contact: clamp(44px,9vw,92px),
// Privacy: clamp(36px,7vw,68px)) — override via `watermarkClass` rather than adding a
// preset enum, since the exact values don't share a clean small set of variants.
// Same reasoning for `labelRowClass`: the dash+label row's margin-bottom is 32px on
// Service/Training but 28px on Company.
//
// QA fix: Training and Privacy had no <h1> anywhere on the page (the handoff's own
// markup doesn't have one either — the label here was always a plain <span>). Service/
// Company/Download/Contact already have a separate, more prominent <h1> elsewhere on the
// page, so this only needs to become the page's <h1> on the two pages that lack one.
interface Props {
  watermark: string;
  label: string;
  watermarkClass?: string;
  labelRowClass?: string;
  headingLevel?: 'h1' | 'span';
}

const {
  watermark,
  label,
  watermarkClass = 'text-[clamp(44px,9vw,84px)]',
  labelRowClass = 'mb-8',
  headingLevel = 'span',
} = Astro.props;
---

<p
  class:list={[
    'text-ghost m-0 mb-1.5 leading-none font-extrabold tracking-[-0.02em] select-none',
    watermarkClass,
  ]}
>
  {watermark}
</p>
<div class:list={['flex items-center gap-2.5', labelRowClass]}>
  <span class="bg-ink h-[1.5px] w-5"></span>
  {
    headingLevel === 'h1' ? (
      <h1 class="text-sm font-bold">{label}</h1>
    ) : (
      <span class="text-sm font-bold">{label}</span>
    )
  }
</div>
