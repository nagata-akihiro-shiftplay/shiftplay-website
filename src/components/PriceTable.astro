---
// White price card (label + note on the left, amount on the right) plus "※" footnotes,
// shared by the /services/* pages.
interface PriceRow {
  label: string;
  note: string;
  amount: string;
  unit?: string;
}

interface Props {
  rows: PriceRow[];
  notes?: string[];
}

const { rows, notes = [] } = Astro.props;
---

<div class="border-border rounded-block border bg-white px-[clamp(20px,3vw,32px)]">
  {
    rows.map((row) => (
      <div class="border-border-soft flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b py-5 last:border-b-0">
        <div>
          <div class="text-[15px] font-extrabold">{row.label}</div>
          <div class="text-faint mt-1 text-xs">{row.note}</div>
        </div>
        <div class="ml-auto flex items-baseline gap-1">
          <span class="text-[clamp(26px,3.4vw,34px)] leading-none font-extrabold tracking-[-0.01em] tabular-nums">
            {row.amount}
          </span>
          {row.unit && <span class="text-muted text-sm font-bold">{row.unit}</span>}
        </div>
      </div>
    ))
  }
</div>
{
  notes.length > 0 && (
    <div class="text-faint mt-4 flex flex-col gap-1 text-xs leading-[1.8]">
      {notes.map((note) => (
        <p class="m-0">※ {note}</p>
      ))}
    </div>
  )
}
