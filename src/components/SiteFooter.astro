---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { mainNavItems } from '../data/nav';

const navCtaBase =
  'gap-[7px] rounded-lg py-2.5 text-sm transition-[background-color,transform] duration-150 active:scale-[0.96]';

const promoCards = [
  {
    href: '/download',
    iconBg: 'bg-icon-dl',
    icon: 'download' as const,
    eyebrow: 'DOWNLOAD',
    title: '資料ダウンロード',
    description:
      '弊社の生成AIサービスについて詳細をご覧になりたい方は、こちらよりサービス資料をダウンロードください。',
  },
  {
    href: '/contact',
    iconBg: 'bg-icon-contact',
    icon: 'mail' as const,
    eyebrow: 'CONTACT',
    title: 'お問い合わせ',
    description:
      'サービスや講演・取材・寄稿などに関するお問い合わせなどはこちらよりご気軽にご連絡ください。',
  },
];
---

<div class="container-full section-px flex flex-wrap gap-5 pb-[clamp(28px,5vw,56px)]">
  {
    promoCards.map((card) => (
      <a
        href={card.href}
        class="rounded-card border-border text-ink flex min-w-[280px] flex-[1_1_380px] items-start gap-[18px] border bg-white p-[clamp(20px,3vw,28px)] no-underline transition-[transform,box-shadow] duration-200 hover:-translate-y-[3px] hover:shadow-[0_12px_30px_rgba(20,22,28,0.08)] active:scale-[0.98]"
      >
        <span
          class={`flex h-[52px] w-[52px] flex-none items-center justify-center rounded-full ${card.iconBg}`}
        >
          <Icon name={card.icon} size={22} class="text-accent" />
        </span>
        <span class="flex-1">
          <span class="text-accent mb-1 block text-xs font-bold tracking-[0.08em]">
            {card.eyebrow}
          </span>
          <span class="text-ink mb-2 flex items-center gap-2 text-lg font-extrabold">
            {card.title}
            <Icon name="chevron-right" />
          </span>
          <span class="text-muted block text-sm leading-[1.8]">{card.description}</span>
        </span>
      </a>
    ))
  }
</div>

<footer class="border-border bg-page text-ink border-t">
  <div
    class="container-full section-px flex flex-wrap items-center justify-between gap-6 pt-11 pb-7"
  >
    <a href="/" class="flex items-center no-underline">
      <Logo width={210} height={72} />
    </a>
    <nav class="flex flex-wrap items-center gap-x-[clamp(14px,3vw,32px)] gap-y-3">
      <div class="flex flex-wrap items-center gap-x-[clamp(14px,3vw,32px)]">
        {
          mainNavItems.map((item) => (
            <a
              href={item.href}
              class="text-muted hover:text-ink px-1 py-2.5 text-sm font-medium no-underline"
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="flex flex-nowrap items-center gap-3">
        <Button href="/download" variant="outline" class={`${navCtaBase} px-[18px]`}>
          <Icon slot="icon" name="download" />資料ダウンロード
        </Button>
        <Button href="/contact" variant="solid-footer" class={`${navCtaBase} px-5`}>
          <Icon slot="icon" name="mail" />お問い合わせ
        </Button>
      </div>
    </nav>
  </div>
  <div
    class="container-full section-px border-border flex flex-wrap justify-between gap-3 border-t pt-5 pb-8"
  >
    <div class="flex flex-wrap gap-[22px]">
      <a href="/privacy" class="text-faint hover:text-ink py-2.5 text-[13px] no-underline"
        >プライバシーポリシー</a
      >
      <a href="/contact" class="text-faint hover:text-ink py-2.5 text-[13px] no-underline"
        >お問い合わせ</a
      >
    </div>
    <div class="text-faint text-[13px]">© ShiftPlay Inc. All Rights Reserved.</div>
  </div>
</footer>
