---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { mainNavItems } from '../data/nav';

const navCtaBase =
  'gap-[7px] rounded-lg py-2.5 text-sm transition-[background-color,transform] duration-150 active:scale-[0.96]';
---

<footer class="border-border bg-page text-ink border-t">
  <div
    class="container-full section-px flex flex-wrap items-center justify-between gap-6 pt-11 pb-7"
  >
    <a href="/" class="flex items-center no-underline">
      <Logo width={150} height={72} />
    </a>
    <nav class="flex flex-wrap items-center gap-x-[clamp(14px,3vw,32px)] gap-y-3">
      <div class="flex flex-wrap items-center gap-x-[clamp(14px,3vw,32px)]">
        {
          mainNavItems.map((item) => (
            <a
              href={item.href}
              class="text-muted hover:text-ink px-1 py-2.5 text-sm font-medium no-underline"
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <Button href="/contact" variant="solid-footer" class={`${navCtaBase} px-5`}>
        <Icon slot="icon" name="mail" />お問い合わせ
      </Button>
    </nav>
  </div>
  {
    /* All three items share the same py-2.5 line box so they sit on one baseline; on phones
      the text drops to 12px and the gaps tighten so the row still fits on one line at 375px. */
  }
  <div
    class="container-full section-px border-border flex flex-wrap items-center justify-between gap-x-3 border-t pt-5 pb-8 text-xs min-[701px]:text-[13px]"
  >
    <div class="flex flex-wrap gap-x-4 min-[701px]:gap-x-[22px]">
      <a href="/privacy" class="text-faint hover:text-ink py-2.5 no-underline"
        >プライバシーポリシー</a
      >
      <a href="/contact" class="text-faint hover:text-ink py-2.5 no-underline">お問い合わせ</a>
    </div>
    <div class="text-faint py-2.5">© 2026 ShiftPlay inc</div>
  </div>
</footer>
