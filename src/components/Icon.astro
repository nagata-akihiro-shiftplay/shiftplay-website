---
type IconName = 'download' | 'mail' | 'chevron-right' | 'arrow-right' | 'close';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 15, class: className } = Astro.props;

// Paths transcribed verbatim from the handoff *.dc.html inline SVGs.
const paths: Record<IconName, string> = {
  download: '<path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M4 19h16"></path>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>',
  'chevron-right': '<path d="M9 18l6-6-6-6"></path>',
  'arrow-right': '<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>',
  close: '<path d="M18 6L6 18"></path><path d="M6 6l12 12"></path>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={paths[name]}
/>
